{
  "name": "wagering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test:unit",
    "db:migrate": "bun scripts/migrate.ts",
    "sqs:setup": "bun scripts/setup-sqs.ts",
    "test:unit": "bun test --parallel test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test --timeout=60000 test/concurrency",
    "test": "bun run test:unit && bun run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1162.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@nestjs/testing": "12.3.3",
    "@types/bun": "1.4.4",
    "@types/express": "5",
    "typescript": "~6.0.3"
  }
}
